@page "/curriculum-vitae"
@using PortfolioWebsite.Components.Models
@using PortfolioWebsite.Components.Services
@using PortfolioWebsite.Components.CV
@inject ICvService CvService

<PageTitle>Curriculum Vitae</PageTitle>

<div class="page-section">
	@foreach (var cvSection in CvSections) {
		<h2 class="section-title">@cvSection.DisplayName</h2>
		@foreach (var cvItem in cvSection.Items) {
			@switch (cvSection.Type) {
    			case CvSectionType.Experience:
                	<CvExperianceCard Item="(CvExperianceItem) cvItem" />
                	break;

            	case CvSectionType.Education:
                	<CvEducationCard Item="(CvEducationItem) cvItem" />
                	break;
			
            	case CvSectionType.TechnicalSkills:
                	<CvTechnicalSkillsCard Item="(CvTechnicalSkillsItem) cvItem" />
                	break;
			
            	case CvSectionType.SoftSkills:
                	<CvSoftSkillsCard Item="(CvSoftSkillsItem) cvItem" />
                	break;
        	}
		}
	}
</div>

@code {
    private List<CvSection> CvSections = new();

    protected override void OnInitialized()
    {
        CvSections = CvService.GetCvSections();
    }
}