@page "/curriculum-vitae"
@using PortfolioWebsite.Components.Models
@using PortfolioWebsite.Components.Services
@inject ICvService CvService

<PageTitle>Curriculum Vitae</PageTitle>

<div class="cv-container">
	@foreach (var section in CvSections) {
		@foreach (var cvItem in section.Items) {
			@switch (section.Type) {
    			case CvSectionType.Experience:
                	<CVExperianceItem Item=cvItem />
                	break;

   				case CvSectionType.Education:
                	<CVCard Item=cvItem />
                	break;
        	}
		}
	}
</div>

@code {
    private List<CvSection> CvSections = new();

    protected override void OnInitialized()
    {
        CvSections = CvService.GetCvSections();
    }
}