@using PortfolioWebsite.Components.Models
<div class="card">

    <div class="card-header">
        <div class="card-right-column">
            @if (!string.IsNullOrEmpty(Item?.Title))
            {
                <h4 class="card-title">@Item.Title</h4>
            }
        
            @if (!string.IsNullOrEmpty(Item?.SubTitle))
            {
                <h4 class="card-subtitle">@Item.SubTitle</h4>
            }
        </div>

        <div class="card-left-column">
            @if (!string.IsNullOrEmpty(Item?.Location))
            {
                <h4 class="card-location">@Item.Location</h4>
            }
        
            @if (!string.IsNullOrEmpty(Item?.Period))
            {
                <h4 class="card-period">@Item.Period</h4>
            }
        </div>
    </div>

    @if (Item?.BulletPoints?.Any() == true)
    {
        <ul class="card-content">
            @foreach (var point in Item.BulletPoints)
            {
                <li>@((MarkupString)point)</li>
            }
        </ul>
    }

</div>

@code {
    [Parameter, EditorRequired]
    public CvEducationItem Item { get; set; }
}
